<div id="report-modal" class="report-modal" aria-hidden="true">
  <div class="report-modal-backdrop" data-report-close></div>
  <section class="report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="report-modal-title">
    <header class="report-modal-header"><h2 id="report-modal-title" data-i18n="report.title">Báo cáo</h2><button type="button" class="report-modal-close" data-report-close aria-label="Close">×</button></header>
    <div class="report-modal-body">
      <h3 id="report-target-label" data-i18n="report.reportingTitle">Báo cáo truyện</h3>
      <div id="report-target-card" class="report-target-card"></div>
      <hr />
      <label for="report-reason" data-i18n="report.reason">Lý do</label>
      <select id="report-reason"><option value="" data-i18n="report.chooseReason">Chọn một lý do</option></select>
      <label for="report-explanation" data-i18n="report.explanation">Giải thích thêm</label>
      <textarea id="report-explanation" maxlength="1000" placeholder=""></textarea>
      <p id="report-modal-error" class="report-modal-error" role="alert" hidden></p>
    </div>
    <footer class="report-modal-actions"><button type="button" class="report-cancel" data-report-close data-i18n="report.cancel">Hủy</button><button type="button" id="report-submit" class="report-submit" data-i18n="report.submit">Gửi báo cáo</button></footer>
  </section>
</div>
