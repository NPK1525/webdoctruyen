@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-i18n="nav.advancedSearch">Advanced Search</title>
    <link rel="stylesheet" href="/css/style.css?v=5.0" />
    <script src="/vendor/lucide/lucide.min.js?v=1.27.0"></script>
  </head>
  <body class="library-page advanced-search-page">
    <div id="root">
      @await Html.PartialAsync("_Header")
      @await Html.PartialAsync("_Sidebar")
      @await Html.PartialAsync("_AuthModal")

      <main id="main-layout">
        <div class="library-shell advanced-search-shell">
          <div class="library-page-title">
            <button type="button" onclick="history.back()" title="Back" data-i18n="common.back" data-i18n-attr="title">
              <i data-lucide="arrow-left"></i>
            </button>
            <h1 data-i18n="nav.advancedSearch">Advanced Search</h1>
          </div>

          <section class="advanced-search-panel">
            <div class="advanced-search-top">
              <label class="advanced-search-input">
                <i data-lucide="search"></i>
                <input id="advanced-search-input" type="search" placeholder="Search" data-i18n="search.placeholder" data-i18n-attr="placeholder" autocomplete="off" />
              </label>
              <button id="advanced-toggle-filters" type="button" class="advanced-filter-toggle">
                <i data-lucide="chevron-down"></i>
                <span data-i18n="search.showFilters">Show filters</span>
              </button>
            </div>

            <div id="advanced-filters" class="advanced-filters" hidden>
              <label>
                <span data-i18n="search.sortBy">Sort by</span>
                <select id="advanced-sort">
                  <option value="" data-i18n="search.sortNone">None</option>
                  <option value="latest" data-i18n="search.sortLatest">Latest upload</option>
                  <option value="title" data-i18n="search.sortTitle">Title</option>
                  <option value="year" data-i18n="search.sortYear">Publication year</option>
                  <option value="views" data-i18n="search.sortViews">Most viewed</option>
                </select>
              </label>
              <label>
                <span data-i18n="filter.type">Type</span>
                <select id="advanced-type">
                  <option value="" data-i18n="search.any">Any</option>
                  <option value="0" data-i18n="filter.typeManga">Manga</option>
                  <option value="1" data-i18n="filter.typeManhwa">Manhwa</option>
                  <option value="2" data-i18n="filter.typeManhua">Manhua</option>
                </select>
              </label>
              <label>
                <span data-i18n="filter.demographic">Magazine Demographic</span>
                <select id="advanced-demographic">
                  <option value="" data-i18n="search.any">Any</option>
                  <option value="1" data-i18n="filter.demographicShounen">Shounen</option>
                  <option value="2" data-i18n="filter.demographicShoujo">Shoujo</option>
                  <option value="3" data-i18n="filter.demographicSeinen">Seinen</option>
                  <option value="4" data-i18n="filter.demographicJosei">Josei</option>
                </select>
              </label>
              <label>
                <span data-i18n="search.publicationStatus">Publication Status</span>
                <select id="advanced-status">
                  <option value="" data-i18n="search.any">Any</option>
                  <option value="0" data-i18n="filter.statusOngoing">Ongoing</option>
                  <option value="1" data-i18n="filter.statusCompleted">Completed</option>
                  <option value="2" data-i18n="filter.statusHiatus">Hiatus</option>
                </select>
              </label>
              <label>
                <span data-i18n="filter.releaseYear">Publication year</span>
                <input id="advanced-year" type="number" min="1900" max="2100" placeholder="Any" data-i18n="search.any" data-i18n-attr="placeholder" />
              </label>
              <label>
                <span data-i18n="search.contentRating">Content Rating</span>
                <select id="advanced-rating">
                  <option value="" data-i18n="search.any">Any</option>
                  <option value="safe" data-i18n="search.safe">Safe</option>
                  <option value="suggestive" data-i18n="search.suggestive">Suggestive</option>
                </select>
              </label>
              <div class="advanced-filter-tags-field">
                <span data-i18n="search.filterTags">Filter tags</span>
                <button id="advanced-filter-tags-trigger" type="button" class="advanced-filter-tags-trigger" aria-expanded="false" aria-controls="advanced-filter-tags-panel">
                  <span id="advanced-filter-tags-label" data-i18n="search.includeAny">Include any</span>
                  <i data-lucide="chevron-down"></i>
                </button>
                <div id="advanced-filter-tags-panel" class="advanced-filter-tags-panel" hidden>
                  <div class="advanced-filter-tags-toolbar">
                    <label class="advanced-filter-tags-search">
                      <i data-lucide="search"></i>
                      <input id="advanced-filter-tags-search" type="search" placeholder="Search tags" data-i18n="search.searchTags" data-i18n-attr="placeholder" autocomplete="off" />
                    </label>
                    <button id="advanced-filter-tags-reset" type="button" class="advanced-filter-tags-reset" data-i18n="filter.clear">Reset</button>
                  </div>
                  <p class="advanced-filter-tags-hint"><i data-lucide="info"></i><span data-i18n="search.tagHint">Click a tag once to include it, twice to exclude it, and again to clear it.</span> <button id="advanced-filter-tags-dismiss" type="button" data-i18n="search.dismiss">Dismiss</button></p>
                  <section class="advanced-filter-tag-group" data-filter-group="format">
                    <h3 data-i18n="filter.format">Format</h3><div id="advanced-filter-tags-format" class="advanced-filter-tag-list"></div>
                  </section>
                  <section class="advanced-filter-tag-group" data-filter-group="genre">
                    <h3 data-i18n="filter.genre">Genre</h3><div id="advanced-filter-tags-genre" class="advanced-filter-tag-list"></div>
                  </section>
                  <section class="advanced-filter-tag-group" data-filter-group="theme">
                    <h3 data-i18n="filter.theme">Theme</h3><div id="advanced-filter-tags-theme" class="advanced-filter-tag-list"></div>
                  </section>
                  <section class="advanced-filter-tag-group" data-filter-group="content">
                    <h3 data-i18n="filter.content">Content</h3><div id="advanced-filter-tags-content" class="advanced-filter-tag-list"></div>
                  </section>
                </div>
              </div>
              <label class="advanced-person-filter">
                <span data-i18n="search.authors">Authors</span>
                <div class="advanced-person-combobox">
                  <input id="advanced-author-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="advanced-author-results" placeholder="Any" data-i18n="search.any" data-i18n-attr="placeholder" autocomplete="off" />
                  <div id="advanced-author-results" class="advanced-person-results" role="listbox" hidden></div>
                  <div id="advanced-author-selected" class="advanced-person-selected"></div>
                </div>
              </label>
              <label class="advanced-person-filter">
                <span data-i18n="search.artists">Artists</span>
                <div class="advanced-person-combobox">
                  <input id="advanced-artist-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="advanced-artist-results" placeholder="Any" data-i18n="search.any" data-i18n-attr="placeholder" autocomplete="off" />
                  <div id="advanced-artist-results" class="advanced-person-results" role="listbox" hidden></div>
                  <div id="advanced-artist-selected" class="advanced-person-selected"></div>
                </div>
              </label>
            </div>

            <div class="advanced-actions">
              <button id="advanced-reset" type="button" class="advanced-reset-btn" data-i18n="search.resetFilters">Reset filters</button>
              <button id="advanced-lucky" type="button" class="advanced-lucky-btn" data-i18n="search.feelingLucky">I'm feeling lucky</button>
              <button id="advanced-search-btn" type="button" class="advanced-search-btn">
                <i data-lucide="search"></i>
                <span data-i18n="filter.search">Search</span>
              </button>
            </div>
          </section>

          <div class="library-toolbar advanced-results-toolbar">
            <h2 id="advanced-count-label">0 Titles</h2>
            <div class="library-view-switcher">
              <button type="button" data-advanced-view="list" title="List view" data-i18n="search.listView" data-i18n-attr="title">
                <i data-lucide="list"></i>
              </button>
              <button type="button" data-advanced-view="compact" title="Compact view" data-i18n="search.compactView" data-i18n-attr="title">
                <i data-lucide="rows-2"></i>
              </button>
              <button type="button" data-advanced-view="grid" title="Grid view" data-i18n="search.gridView" data-i18n-attr="title">
                <i data-lucide="grid-2x2"></i>
              </button>
            </div>
          </div>

          <div id="advanced-loading" class="library-empty" style="display: none;" data-i18n="common.loading">Loading...</div>
          <div id="advanced-empty" class="library-empty" style="display: none;"></div>
          <div id="advanced-results" class="library-items list"></div>
          <div id="advanced-pagination" class="library-pagination"></div>
        </div>
      </main>
    </div>

    <script src="/js/i18n.js?v=4.0"></script>
    <script src="/js/common-library.js?v=1.1"></script>
    <script src="/js/common-auth.js?v=1.0"></script>
<script src="/js/common.js?v=5.8"></script>
    <script src="/js/advanced-search-filters.js?v=1.2"></script>
    <script src="/js/advanced-search.js?v=1.2"></script>
  </body>
</html>
