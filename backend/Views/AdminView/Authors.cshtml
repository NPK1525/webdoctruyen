@model List<MangaNPK.Models.Author>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý tác giả - Admin</title>
  <link rel="stylesheet" href="/css/style.css?v=5.0">
  <script src="/vendor/lucide/lucide.min.js?v=1.27.0"></script>
</head>
<body class="admin-page reports-page">
  <div id="root">
    <header id="global-header" class="glass admin-global-header">
      <div class="container admin-header-inner">
        <div class="admin-brand-group">
          <button id="sidebar-toggle-btn" class="admin-menu-btn"><i data-lucide="menu"></i></button>
          <a href="/admin" class="admin-brand"><i data-lucide="book-open"></i><span>Manga<span>NPK</span></span></a>
          <span class="admin-panel-label" data-i18n="admin.controlPanel">ADMIN CONTROL PANEL</span>
        </div>
        <div id="header-user-area" class="admin-user-area"></div>
      </div>
    </header>
    @await Html.PartialAsync("_Sidebar")
    <main class="reports-shell admin-reports-shell">
      <div class="reports-heading">
        <div>
          <a class="reports-back" href="/admin" data-i18n="admin.backToPanel">← Bảng quản trị</a>
          <h1 data-i18n="admin.authors">Quản lý tác giả</h1>
          <p data-i18n="admin.authorsDescription">Thêm, chỉnh sửa và quản lý tác giả dùng trong form tạo truyện.</p>
        </div>
        <span class="reports-role-badge">AUTHORS</span>
      </div>
      <section class="management-grid">
        <form asp-action="AuthorCreate" method="post" class="reports-panel management-form">
          @Html.AntiForgeryToken()
          <h2 data-i18n="admin.addAuthor">Thêm tác giả</h2>
          <label><span data-i18n="admin.authorNamePlain">Tên tác giả</span><input name="name" required></label>
          <label><span data-i18n="admin.biography">Tiểu sử</span><textarea name="biography" rows="4"></textarea></label>
          <button class="management-primary" data-i18n="admin.addAuthor">Thêm tác giả</button>
        </form>
        <section class="reports-panel">
          <div class="management-toolbar">
            <input id="author-search" placeholder="Tìm tác giả..." data-i18n="admin.searchAuthors" data-i18n-attr="placeholder">
          </div>
          <div class="management-list">
            @foreach (var author in Model)
            {
              <article class="management-row">
                <form asp-action="AuthorUpdate" asp-route-id="@author.Id" method="post">
                  @Html.AntiForgeryToken()
                  <input name="name" value="@author.Name" required>
                  <input name="biography" value="@author.Biography" type="hidden">
                  <button class="management-save" data-i18n="admin.save">Lưu</button>
                </form>
                <form asp-action="AuthorDelete" asp-route-id="@author.Id" method="post" class="admin-delete-author-form">
                  @Html.AntiForgeryToken()
                  <button class="management-delete" data-i18n="admin.delete">Xóa</button>
                </form>
              </article>
            }
            @if (!Model.Any())
            {
              <p class="management-empty" data-i18n="admin.noAuthors">Chưa có tác giả.</p>
            }
          </div>
        </section>
      </section>
    </main>
  </div>
  <script src="/js/i18n.js?v=4.0"></script>
  <script src="/js/common-auth.js?v=1.0"></script>
  <script src="/js/common.js?v=5.8"></script>
  <script>
    document.getElementById('author-search')?.addEventListener('input', event =>
      document.querySelectorAll('.management-row').forEach(row =>
        row.hidden = !row.textContent.toLowerCase().includes(event.target.value.toLowerCase())));
    document.querySelectorAll('.admin-delete-author-form').forEach(form =>
      form.addEventListener('submit', event => {
        if (!confirm(t('admin.confirmDeleteAuthor', 'Xóa tác giả này?'))) event.preventDefault();
      }));
  </script>
</body>
</html>
